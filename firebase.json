{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [{ "source": "/ranking/", "destination": "/ranking", "type": 301 }],
    "rewrites": [{ "source": "/ranking", "destination": "/index.html" }]
  },
  "emulators": {
    "firestore": { "host": "0.0.0.0", "port": 8080 },
    "ui": { "enabled": false }
  }
}
